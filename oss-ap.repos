# Exe_ServiceCreator 가 링크하는 ROS 2 메시지 패키지. 버전은 상대 Autoware 구성과
# 맞춘다. Autoware 전체는 빌드하지 않는다 — .msg/.srv 정의만 있으면 된다.
#
#   autoware_msgs           planning · perception · map
#   autoware_adapi_msgs     adapi_v1
#   autoware_internal_msgs  위 패키지들의 의존
#   tier4_autoware_msgs     tier4_planning
repositories:
  msgs/autoware_msgs:
    type: git
    url: https://github.com/autowarefoundation/autoware_msgs.git
    version: 1.3.0
  msgs/autoware_adapi_msgs:
    type: git
    url: https://github.com/autowarefoundation/autoware_adapi_msgs.git
    version: beta/1.7.0
  msgs/autoware_internal_msgs:
    type: git
    url: https://github.com/autowarefoundation/autoware_internal_msgs.git
    version: 1.5.0
  msgs/tier4_autoware_msgs:
    type: git
    url: https://github.com/tier4/tier4_autoware_msgs.git
    version: v0.41.0
